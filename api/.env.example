DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit?schema=public

# Base URL of the frontend, used to build password-reset links
APP_URL=http://localhost:3090

# SMTP config for outgoing email (password recovery).
# If SMTP_HOST is unset, reset links are logged to the API console instead of emailed.
SMTP_HOST=mail.nei-isep.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@nei-isep.org
SMTP_PASS=
SMTP_FROM=ORBIT <no-reply@nei-isep.org>

# External access lifecycle. Configure in the API only; never NEXT_PUBLIC_*.
# Keep disabled until resources, identities and approvals have been reviewed.
ACCESS_EXECUTOR_ENABLED=false
ACCESS_EXECUTOR_DRY_RUN=true
ACCESS_FORMS_URL=
ACCESS_SHEETS_ID=
# Include headers and an explicit final row, e.g. 'Respostas ao formulário 1!A1:Z5000'.
ACCESS_SHEETS_RANGE=
# Optional JSON column-title mapping; defaults documented in docs/access-lifecycle.md.
# Existing Membros headings stay valid. Optional new headers: Email Google,
# Username GitHub, Email Figma, Email Coda, Email Freedcamp (M:Q in the example).
ACCESS_SHEETS_COLUMNS=
# JSON mapping of Forms department labels to existing Orbit department UUIDs.
ACCESS_SHEETS_DEPARTMENTS=
# Optional JSON mapping of existing Sheets Cargo labels to the supported position enum.
ACCESS_SHEETS_POSITIONS=
# Optional JSON bootstrap patches keyed by the seed's stable resource keys.
# Private invite links belong here in secret storage, never in the repository.
ACCESS_BOOTSTRAP_RESOURCES=
# Optional JSON of existing Orbit role names to ACCESS_* permission arrays.
# Explicit configuration replaces only ACCESS_* permissions on the named roles.
ACCESS_BOOTSTRAP_ROLE_PERMISSIONS=
# Service account with read access to intake Sheets and explicit access to managed Drive roots.
# Encode PEM line breaks as \n when using single-line environment variables.
ACCESS_GOOGLE_CLIENT_EMAIL=
ACCESS_GOOGLE_PRIVATE_KEY=
ACCESS_DISCORD_BOT_TOKEN=
# GitHub App installation in the managed organization. No personal administrator PAT.
ACCESS_GITHUB_APP_ID=
ACCESS_GITHUB_INSTALLATION_ID=
ACCESS_GITHUB_PRIVATE_KEY=
