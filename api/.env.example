DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit?schema=public

# Base URL of the frontend, used to build password-reset links
APP_URL=http://localhost:3090

# SMTP config for outgoing email (password recovery).
# If SMTP_HOST is unset, reset links are logged to the API console instead of emailed.
SMTP_HOST=mail.nei-isep.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@nei-isep.org
SMTP_PASS=
SMTP_FROM=ORBIT <noreply@nei-isep.org>
